# ============================================
# School Parent App - Environment Variables
# ============================================
# Copy this file to .env in each project directory
# and fill in your Supabase project credentials.
#
# NEVER commit .env files to version control.
# ============================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# For React Native (Expo) - same values, different prefix
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. Use the ANON/PUBLIC key only. NEVER use the service_role key in frontend code.
# 2. For Phone OTP authentication, configure an SMS provider in Supabase Dashboard:
#    - Go to Authentication > Providers > Phone
#    - Enable Phone provider
#    - Configure Twilio or another SMS provider
#    - Set OTP expiry and length
# 3. RLS policies protect your data - the anon key is safe to use in frontends.
# ============================================

